				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "DECLARE @latest_time_str VARCHAR(50) = '@{pipeline().parameters.latest_time}';\nDECLARE @current_time_str VARCHAR(50) = '@{formatDateTime(utcnow(), 'yyyy-MM-dd HH:mm:ss')}';\n\nDECLARE @start_year INT = CAST(LEFT(@latest_time_str, 4) AS INT);\nDECLARE @start_month INT = CAST(SUBSTRING(@latest_time_str, 6, 2) AS INT);\nDECLARE @end_year INT = CAST(LEFT(@current_time_str, 4) AS INT);\nDECLARE @end_month INT = CAST(SUBSTRING(@current_time_str, 6, 2) AS INT);\n\nDECLARE @total_months INT = (@end_year - @start_year) * 12 + (@end_month - @start_month) + 1;\n\n;WITH Numbers AS (\n    SELECT 0 AS n\n    UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4\n    UNION ALL SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7 UNION ALL SELECT 8\n    UNION ALL SELECT 9 UNION ALL SELECT 10 UNION ALL SELECT 11 UNION ALL SELECT 12\n),\nMonthCalculations AS (\n    SELECT \n        n,\n        (@start_year * 12 + @start_month - 1 + n) / 12 AS calc_year,\n        ((@start_year * 12 + @start_month - 1 + n) % 12) + 1 AS calc_month\n    FROM Numbers\n    WHERE n < @total_months\n)\nSELECT \n    CAST(calc_year AS VARCHAR(4)) AS year, \n    RIGHT('0' + CAST(calc_month AS VARCHAR(2)), 2) AS month\nFROM MonthCalculations\nORDER BY calc_year, calc_month;\n",
								"type": "Expression"
							}
						}
					],
