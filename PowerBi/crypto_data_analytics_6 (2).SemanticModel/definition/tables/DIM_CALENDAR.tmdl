	partition DIM_CALENDAR = calculated
		mode: import
		source = ```
				
				VAR StartDate = DATE(2021, 1, 1)
				VAR EndDate   = DATE(2026, 12, 31)
				RETURN
				ADDCOLUMNS (
				    CALENDAR (StartDate, EndDate),
				
				    "year", YEAR([Date]),
				    "month_number", MONTH([Date]),
				    "month_name", FORMAT([Date], "MMM"),
				    "year_month", FORMAT([Date], "YYYY-MM"),
				    "quarter", "Q" & FORMAT([Date], "Q"),
				
				    "week_of_year", WEEKNUM([Date]),
				    "day_of_week", WEEKDAY([Date], 2),
				    "day_name", FORMAT([Date], "DDD"),
				
				    "is_weekend", IF(WEEKDAY([Date], 2) > 5, TRUE(), FALSE())
				)
				
				```

	annotation PBI_Id = 36c4845710014001ad1b049ace8b0c40

