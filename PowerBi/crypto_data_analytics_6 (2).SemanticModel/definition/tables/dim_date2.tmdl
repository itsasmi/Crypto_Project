	partition dim_date2 = calculated
		mode: import
		source = ```
				
				VAR StartDate = DATE(2021, 1, 1)
				VAR EndDate   = DATE(2026, 12, 31)
				RETURN
				ADDCOLUMNS (
				    GENERATE (
				        CALENDAR (StartDate, EndDate),
				        GENERATESERIES (0, 23, 1)
				    ),
				
				    /* Date fields */
				    "date_key", [Date],
				    "year", YEAR([Date]),
				    "month_number", MONTH([Date]),
				    "month_name", FORMAT([Date], "MMM"),
				    "year_month", FORMAT([Date], "YYYY-MM"),
				    "quarter", "Q" & FORMAT([Date], "Q"),
				
				    "week_of_year", WEEKNUM([Date]),
				    "day_of_week", WEEKDAY([Date], 2),
				    "day_name", FORMAT([Date], "DDD"),
				    "is_weekend", WEEKDAY([Date], 2) > 5,
				
				    /* Hour fields */
				    "hour_of_day", [Value],
				    "hour_label", FORMAT(TIME([Value], 0, 0), "HH:00"),
				
				    /* Combined datetime (optional but useful) */
				    "date_hour_ts", [Date] + TIME([Value], 0, 0)
				)
				
				```

	annotation PBI_Id = f4f74970b1cb4f2aa090de75502fc853

