	measure 'Daily Return (%)' = ```
			
			VAR CurrentDate =
			    SELECTEDVALUE(DIM_CALENDAR[Date])
			
			VAR FirstHour =
			    CALCULATE(
			        MIN('FACT_CRYPTO_DATA'[Hour Started At]),
			        'FACT_CRYPTO_DATA'[Trade Date On] = CurrentDate
			    )
			
			VAR LastHour =
			    CALCULATE(
			        MAX('FACT_CRYPTO_DATA'[Hour Started At]),
			        'FACT_CRYPTO_DATA'[Trade Date On] = CurrentDate
			    )
			
			VAR OpenPrice =
			    CALCULATE(
			        AVERAGE('FACT_CRYPTO_DATA'[Open Price]),
			        'FACT_CRYPTO_DATA'[Hour Started At] = FirstHour
			    )
			
			VAR ClosePrice =
			    CALCULATE(
			        AVERAGE('FACT_CRYPTO_DATA'[Close Price]),
			        'FACT_CRYPTO_DATA'[Hour Started At] = LastHour
			    )
			
			RETURN
			DIVIDE(ClosePrice - OpenPrice, OpenPrice)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b01bde8a-8cec-4f69-9b27-8ada6c4f1f7e

	measure 'Daily Volume' =
			
