table FACT_CRYPTO_DATA
	lineageTag: da562e1e-e1c6-49f9-90c4-81c80022924e

	measure 'Rolling Avg Volume (20 Days)' =
			
			VAR CurrentDate = MAX(DIM_CALENDAR[Date])
			RETURN
			AVERAGEX(
			    FILTER(
			        ALL(DIM_CALENDAR),
			        DIM_CALENDAR[Date] <= CurrentDate &&
			        DIM_CALENDAR[Date] > CurrentDate - 20
			    ),
			    CALCULATE(SUM('FACT_CRYPTO_DATA'[Volume]))
			)
		lineageTag: 820c19c1-db0e-45c1-b07e-0ad2e3552e61

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Beta to BTC (30 Days)' =
			
			VAR AssetAvg =
			    AVERAGEX(
			        DATESINPERIOD(
			            DIM_CALENDAR[Date],
			            MAX(DIM_CALENDAR[Date]),
			            -30,
			            DAY
			        ),
			        [Daily Return (%)]
			    )
			
			VAR BTCAvg =
			    AVERAGEX(
			        DATESINPERIOD(
			            DIM_CALENDAR[Date],
			            MAX(DIM_CALENDAR[Date]),
			            -30,
			            DAY
			        ),
			        [BTC Daily Return]
			    )
			
			VAR CovarValue =
			    AVERAGEX(
			        DATESINPERIOD(
			            DIM_CALENDAR[Date],
			            MAX(DIM_CALENDAR[Date]),
			            -30,
			            DAY
			        ),
			        ([Daily Return (%)] - AssetAvg) *
			        ([BTC Daily Return] - BTCAvg)
			    )
			
			VAR BTCVariance =
			    VAR BTCStd =
			        STDEVX.P(
			            DATESINPERIOD(
			                DIM_CALENDAR[Date],
			                MAX(DIM_CALENDAR[Date]),
			                -30,
			                DAY
			            ),
			            [BTC Daily Return]
			        )
			    RETURN BTCStd * BTCStd
			
			RETURN
			DIVIDE(
			    CovarValue,
			    BTCVariance
			)
		lineageTag: fa6ee011-2da0-4377-a316-ab0ae739aeb6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

