	measure 'Dynamic CandleStickChart Title' = ```
			
			VAR Pair =
			    SELECTEDVALUE('FACT_CRYPTO_DATA'[Trading Pair], "All Pairs")
			
			VAR StartDate =
			    MIN('DIM_CALENDAR'[Date])
			
			VAR EndDate =
			    MAX('DIM_CALENDAR'[Date])
			
			RETURN
			" Price Trends for " & Pair & " " & " from " & 
			FORMAT(StartDate, "dd MMM yyyy") &
			" to " &
			FORMAT(EndDate, "dd MMM yyyy") 
