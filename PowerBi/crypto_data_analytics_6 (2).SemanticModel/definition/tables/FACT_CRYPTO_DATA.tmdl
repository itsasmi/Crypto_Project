	measure 'Market Regime' =
			
			VAR TSIValue = [Trend Strength Index]
			VAR ReturnValue = [Daily Return (%)]
			VAR VolValue = [Rolling Volatility (30 Days)]
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    TSIValue > 0.6 && ReturnValue > 0,
			        "Trending Up",
			
			    TSIValue > 0.6 && ReturnValue < 0,
			        "Trending Down",
			
			    TSIValue < 0.3 && VolValue > 0.05,
			        "High Volatility Range",
			
			    "Low Volatility Range"
			)
		lineageTag: 7473757d-a36e-4bea-83ea-a41654ed0c36

