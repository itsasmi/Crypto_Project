	measure 'Hourly Log Return' =
			
			VAR CurrentHour =
			    MAX('FACT_CRYPTO_DATA'[Hour Started At])
			
			VAR PrevClose =
			    CALCULATE(
			        MAX('FACT_CRYPTO_DATA'[Close Price]),
			        FILTER(
			            ALL('FACT_CRYPTO_DATA'),
			            'FACT_CRYPTO_DATA'[Hour Started At] =
			                CurrentHour - TIME(1,0,0)
			                && 'FACT_CRYPTO_DATA'[Trading Pair] =
			                   SELECTEDVALUE('FACT_CRYPTO_DATA'[Trading Pair])
			        )
			    )
			
			VAR CurrentClose =
			    MAX('FACT_CRYPTO_DATA'[Close Price])
			
			RETURN
			IF(
			    NOT ISBLANK(PrevClose),
			    LOG(CurrentClose / PrevClose)
			)
		lineageTag: 94e7cefb-26f0-446a-9a54-0c4fbb5b32fd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Hourly Open' = ```
			
