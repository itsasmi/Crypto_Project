	measure 'Rolling Correlation (30 Days)' = ```
			
			VAR AssetAvg =
			    AVERAGEX(
			        DATESINPERIOD(
			            DIM_CALENDAR[Date],
			            MAX(DIM_CALENDAR[Date]),
			            -30,
			            DAY
			        ),
			        [Daily Return (%)]
			    )
			
			VAR BTCAvg = 
			    AVERAGEX(
			        DATESINPERIOD(
			            DIM_CALENDAR[Date],
			            MAX(DIM_CALENDAR[Date]),
			            -30,
			            DAY
			        ),
			        [BTC Daily Return]
			    )
			
			VAR CovarValue =
			    AVERAGEX(
			        DATESINPERIOD(
			            DIM_CALENDAR[Date],
			            MAX(DIM_CALENDAR[Date]),
			            -30,
			            DAY
			        ),
			        ([Daily Return (%)] - AssetAvg) *
			        ([BTC Daily Return] - BTCAvg)
			    )
			
			VAR AssetStd =
			    STDEVX.P(
			        DATESINPERIOD(
			            DIM_CALENDAR[Date],
			            MAX(DIM_CALENDAR[Date]),
			            -30,
			            DAY
			        ),
			        [Daily Return (%)]
			    )
			
			VAR BTCStd =
			    STDEVX.P(
			        DATESINPERIOD(
			            DIM_CALENDAR[Date],
			            MAX(DIM_CALENDAR[Date]),
			            -30,
			            DAY
			        ),
			        [BTC Daily Return]
			    )
			
			RETURN
			DIVIDE(
			    CovarValue,
			    AssetStd * BTCStd
			)
			
			```
		formatString: 0.00
		lineageTag: 1bd2cf72-0727-4e6b-8778-01fea75bc889

