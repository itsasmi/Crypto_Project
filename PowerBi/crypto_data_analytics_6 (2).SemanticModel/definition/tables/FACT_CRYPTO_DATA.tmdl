	measure 'Rolling Volatility (7 Days)' =
			
			VAR Window =
			    DATESINPERIOD(
			        DIM_CALENDAR[Date],
			        MAX(DIM_CALENDAR[Date]),
			        -7,
			        DAY
			    )
			RETURN
			SQRT(7) *
			STDEVX.P(
			    CALCULATETABLE(
			        VALUES(DIM_CALENDAR[Date]),
			        Window
			    ),
			    [Daily Log Return]
			)
		lineageTag: 84b69471-43de-4308-9eae-999dfe579804

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Rolling Volatility (30 Days)' =
			
