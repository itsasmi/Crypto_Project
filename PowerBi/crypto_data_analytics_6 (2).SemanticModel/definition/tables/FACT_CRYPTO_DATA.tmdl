	measure 'Hourly High Return' =
			
			MAXX(
			    VALUES('FACT_CRYPTO_DATA'[Hour Started At]),
			    [Hourly Return (%)]
			)
		formatString: 0.00
		lineageTag: 693192f7-82da-4664-8ea7-1db3d5d5eeb2

	measure 'Hourly Low Return' =
			
			MINX(
			    VALUES('FACT_CRYPTO_DATA'[Hour Started At]),
			    [Hourly Return (%)]
			)
		formatString: 0.00
		lineageTag: c37964cd-1acb-4fe2-839d-fe93cb65b3ed

	measure 'Previous Day Return' =
			
			VAR LatestFactDate =
			    CALCULATE(
			        MAX('FACT_CRYPTO_DATA'[Trade Date On]),
			        REMOVEFILTERS(DIM_CALENDAR)
			    )
			
			VAR PreviousAvailableDate =
			    CALCULATE(
			        MAX('FACT_CRYPTO_DATA'[Trade Date On]),
			        FILTER(
			            ALL('FACT_CRYPTO_DATA'),
			            'FACT_CRYPTO_DATA'[Trade Date On] < LatestFactDate
			        )
			    )
			
			RETURN
			CALCULATE(
			    [Daily Return (%)],
			    DIM_CALENDAR[Date] = PreviousAvailableDate
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 70570031-bcb3-4583-9b5c-29444accdd8b

	measure 'Previous Available Date' =
			
			VAR LatestFactDate =
			    CALCULATE(
			        MAX('FACT_CRYPTO_DATA'[Trade Date On]),
			        REMOVEFILTERS(DIM_CALENDAR)
			    )
			
			RETURN
			CALCULATE(
			    MAX('FACT_CRYPTO_DATA'[Trade Date On]),
			    FILTER(
			        ALL('FACT_CRYPTO_DATA'),
			        'FACT_CRYPTO_DATA'[Trade Date On] < LatestFactDate
			    )
			)
		formatString: General Date
		lineageTag: 32af82d9-873a-4f6c-9ab8-e19a1f6e6764

	measure 'Previous Day Return (Display)' =
			
			VAR ReturnValue = [Previous Day Return]
			
			VAR Arrow =
			    IF(
			        ReturnValue > 0,
			        "↑",
			        IF(ReturnValue < 0, "↓", "")
			    )
			
			RETURN
			Arrow & " " & FORMAT(ReturnValue, "0.00%")
		lineageTag: 79155e3e-398e-48ff-bc20-1f54137ca707

	measure 'Previous Day Return Color' =
			
			VAR ReturnValue = [Previous Day Return]
			RETURN
			SWITCH(
			    TRUE(),
			    ReturnValue > 0, "#00C853",   -- Green
			    ReturnValue < 0, "#D50000",   -- Red
			    "#9E9E9E"                     -- Neutral grey
			)
		lineageTag: 37ce5a9f-2285-4fe8-ab7b-5613de8a271e

	measure 'Previous Day Title' =
			
			FORMAT([Previous Available Date], "dd MMMM yyyy")
		lineageTag: 4487e76a-67f2-48c1-bf8f-72c4a52e6f33

