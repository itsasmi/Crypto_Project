{
	"name": "dataflow_full_complete",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Dataset_complete",
						"type": "DatasetReference"
					},
					"name": "AdlsRaw"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_synapse_silver_crypto",
						"type": "DatasetReference"
					},
					"name": "SinkSynapse",
					"rejectedDataLinkedService": {
						"referenceName": "LS_ADLS_CryptoRawStorage_Dev",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "derivedColumns",
					"description": "derived the column base_asset, quote_asset and trade_date"
				},
				{
					"name": "FilterNewRecords"
				}
			],
			"scriptLines": [
				"parameters{",
				"     trading_pair as string,",
				"     p_year as string,",
				"     p_month as string,",
				"     latest_time as string,",
				"     lp_day as string,",
				"     lp_hour as string,",
				"     lp_minute as string,",
				"     lp_second as string",
				"}",
				"source(output(",
				"          trading_pair as string,",
				"          open_time as long,",
				"          open_price as double,",
				"          high_price as double,",
				"          low_price as double,",
				"          close_price as double,",
				"          volume as double,",
				"          close_time as long,",
				"          quote_asset_volume as double,",
				"          number_of_trades as integer,",
				"          taker_buy_base_asset_volume as double,",
				"          taker_buy_quote_asset_volume as double",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: true,",
				"     ignoreNoFilesFound: true,",
				"     wildcardPaths:[(concat('binance/', $trading_pair, '/', $p_year, '/', $p_month, '.csv'))]) ~> AdlsRaw",
				"AdlsRaw derive(quote_asset = \"USDT\",",
				"          base_asset = substring(trading_pair, 0, length(trading_pair) - 4),",
				"          open_time = toTimestamp(open_time),",
				"          trade_date = toDate(toTimestamp(toLong(substring(toString(open_time), 1, 10)) * 1000)),",
				"          close_time = toTimestamp(close_time)) ~> derivedColumns",
				"derivedColumns filter(close_time > toTimestamp(",
				"    $p_year + '-' +",
				"    lpad($p_month, 2, '0') + '-' +",
				"    lpad($lp_day, 2, '0') + ' ' +",
				"    lpad($lp_hour, 2, '0') + ':' +",
				"    lpad($lp_minute, 2, '0') + ':' +",
				"    lpad($lp_second, 2, '0'),",
				"    'yyyy-MM-dd HH:mm:ss'",
				")) ~> FilterNewRecords",
				"FilterNewRecords sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          trading_pair as string,",
				"          base_asset as string,",
				"          quote_asset as string,",
				"          open_timestamp as timestamp,",
				"          close_timestamp as timestamp,",
				"          trade_date as date,",
				"          open_price as double,",
				"          high_price as double,",
				"          low_price as double,",
				"          close_price as double,",
				"          volume as double,",
				"          quote_volume as double,",
				"          number_of_trades as integer,",
				"          taker_buy_base_volume as double,",
				"          taker_buy_quote_volume as double",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          trading_pair,",
				"          base_asset,",
				"          quote_asset,",
				"          open_timestamp = open_time,",
				"          close_timestamp = close_time,",
				"          trade_date,",
				"          open_price,",
				"          high_price,",
				"          low_price,",
				"          close_price,",
				"          volume,",
				"          quote_volume = quote_asset_volume,",
				"          number_of_trades,",
				"          taker_buy_base_volume = taker_buy_base_asset_volume,",
				"          taker_buy_quote_volume = taker_buy_quote_asset_volume",
				"     )) ~> SinkSynapse"
			]
		}
	}
}